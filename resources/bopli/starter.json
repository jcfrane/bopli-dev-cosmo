{
  "version": 1,
  "contentModels": [
    {
      "handle": "project",
      "name": "Projects",
      "singularName": "Project",
      "description": "Selected work and experiments.",
      "fields": [
        {
          "key": "summary",
          "label": "Summary",
          "type": "long_text",
          "required": true
        },
        { "key": "url", "label": "URL", "type": "short_text" },
        {
          "key": "featured",
          "label": "Featured",
          "type": "boolean",
          "filterable": true
        }
      ],
      "publicRoute": {
        "template": "project",
        "path": "/projects/{slug}",
        "fieldMap": { "summary": "summary", "externalUrl": "url" },
        "seoDescriptionField": "summary"
      }
    }
  ],
  "entries": [
    {
      "model": "project",
      "title": "Bopli",
      "slug": "bopli",
      "status": "published",
      "data": {
        "summary": "A multi-tenant publishing platform with per-site databases and swappable public themes.",
        "url": "https://github.com/jcfrane",
        "featured": true
      }
    },
    {
      "model": "project",
      "title": "Dev Cosmo",
      "slug": "dev-cosmo",
      "status": "published",
      "data": {
        "summary": "The cosmic Ubuntu-inspired theme rendering the very page you are looking at.",
        "url": "https://github.com/jcfrane",
        "featured": true
      }
    },
    {
      "model": "project",
      "title": "Laravel Lens",
      "slug": "laravel-lens",
      "status": "draft",
      "data": {
        "summary": "An image transformation boundary for Laravel applications.",
        "url": "",
        "featured": false
      }
    }
  ],
  "pages": [
    {
      "title": "Home",
      "path": "/",
      "template": "home",
      "status": "published",
      "data": { "body": "Welcome to my site." }
    },
    {
      "title": "About",
      "path": "/about",
      "template": "about",
      "status": "published",
      "data": {
        "body": "Write a short introduction about yourself, your work, and what visitors can expect to find here.\n\nYou can edit this content at any time from the Bopli Page editor."
      }
    }
  ],
  "blog": { "enabled": true }
}
