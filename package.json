{
    "name": "@bopli-theme/dev-cosmo",
    "private": true,
    "version": "0.7.0",
    "type": "module",
    "description": "The Dev Cosmo public theme for Boply.",
    "author": "Boply",
    "license": "MIT",
    "bopli": {
        "handle": "dev-cosmo",
        "name": "Dev Cosmo",
        "requires": "^0.1",
        "colorModes": ["light", "dark"],
        "preview": "resources/images/dev-cosmo-preview.png",
        "settings": {
            "accent_color": {
                "name": "Accent color",
                "type": "color",
                "description": "Color used for prompts, links, and interface highlights.",
                "default": "#e95420"
            },
            "show_theme_toggle": {
                "name": "Show theme toggle",
                "type": "boolean",
                "default": true
            },
            "homepage_post_count": {
                "name": "Homepage post count",
                "type": "select",
                "options": ["6", "10", "12"],
                "default": "10"
            },
            "author_portrait": {
                "name": "Author portrait",
                "type": "image",
                "description": "Optional portrait used on About and Blog post pages.",
                "default": null
            }
        }
    },
    "scripts": {
        "validate": "bopli-theme validate .",
        "types:check": "vue-tsc --noEmit -p tsconfig.json",
        "build": "npm run types:check && bopli-theme build .",
        "dev": "bopli-theme dev . --app ../bopli-app"
    },
    "devDependencies": {
        "@bopli/theme-cli": "file:../bopli-theme-toolkit/packages/cli",
        "@bopli/theme-sdk": "file:../bopli-theme-toolkit/packages/sdk",
        "typescript": "^5.9.3",
        "vite": "^8.0.0",
        "vue": "^3.5.13",
        "vue-tsc": "^2.2.4"
    }
}
